{
  "watch": ["src"],
  "ext": "js,json",
  "ignore": ["node_modules", "uploads", "*.log"],
  "delay": 2000,
  "verbose": false,
  "restartable": "rs",
  "env": {
    "NODE_ENV": "development"
  },
  "events": {
    "restart": "echo 'Server restarting...'"
  },
  "signal": "SIGTERM",
  "legacyWatch": true
}
