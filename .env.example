# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Use Render PostgreSQL Connection String)
DATABASE_URL=postgresql://username:password@host:port/database

# Firebase Admin SDK (paste your serviceAccountKey.json as single-line JSON)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
LIKE_LIMIT_PER_DAY=50
MESSAGE_LIMIT_PER_HOUR=100
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# Security (Add your Vercel URL)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Features
ENABLE_AI_VERIFICATION=false
ENABLE_REAL_TIME_MESSAGING=false
